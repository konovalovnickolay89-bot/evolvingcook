# Evolving Cook Django — example env (copy to .env, chmod 600)
# Real secrets live only in .env (gitignored).

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.apidiscoverysolution.uk,127.0.0.1,localhost

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=evolving_cook
PGUSER=evolving_cook_app
PGPASSWORD=change-me

# Published frontend origin(s), comma-separated. Empty until FE ships.
# Preview regex ^https://.*\.grok-sandbox\.com$ is hard-coded in settings.
# DEV-ONLY: frontend agent test harness (loopback). Strip after publish.
# When Grok supplies PREVIEW_ORIGIN, append that exact origin to this list.
# Exact published FE origins (comma-separated). grok-sandbox.com also matched by regex.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173,https://evolvingcook.grok.me,https://evolving-cook.grok.me

DJANGO_SUPERUSER_EMAIL=mykola@apidiscoverysolution.uk
APP_VERSION=0.1.15
CONTRACT_VERSION=0.1.15

# Phase 3 unexplained-variance noise floor (absolute base units)
# VARIANCE_NOISE_FLOOR=0.001

# Login rate limit for django-ratelimit (IP-keyed)
AUTH_LOGIN_RATELIMIT=10/5m

# Phase 1 ingest_catalog — Mistral (D10). Live extraction blocked when key unset.
# Mykola sets MISTRAL_API_KEY in real .env only — never commit secrets.
# MISTRAL_API_KEY=
# LLM_MODEL=mistral-medium-latest

# Phase 5 / D11 Hermes A2A (loopback only). Never commit real values.
# A2A_TOKEN=   # same as Hermes A2A_PEER_TOKENS evolving-cook:<token> or A2A_BEARER_TOKEN
# WEBHOOK_SECRET=  # same as Hermes A2A_PUSH_SECRET
# A2A_BASE_URL=http://127.0.0.1:9900
# A2A_PUSH_CALLBACK_URL=http://127.0.0.1:8000/api/internal/agent-events
# A2A_INTERNAL_LOOPBACK_ONLY=true
